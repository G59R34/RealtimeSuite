{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealtimeSuite Server Manager",
  "version": "2.0.0",
  "identifier": "com.realtimesuite.manager",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RealtimeSuite Server Manager",
        "width": 1080,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#f4f7fb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}

# RealtimeCorp configuration
# Copy to corp/.env and fill in from your Supabase project settings.

# Supabase project URL (Project settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# The public "anon" key. Safe to ship to the browser: row level security in
# corp/supabase/migrations/0001_realtimecorp.sql decides what each user may read.
# NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=

# RealtimeSuite backend configuration
# Copy to backend/.env and edit before first start.

# Postgres connection (psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/suite

# Signing secret for local sessions. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-before-deploying
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=720

# Bind to all interfaces so other devices on the LAN can reach the suite.
HOST=0.0.0.0
PORT=8000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First-run administrator (only used when the database has no users).
BOOTSTRAP_ADMIN_EMAIL=admin@realtimesuite.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Organization name created on first boot.
ORGANIZATION_NAME=RealtimeSuite

# Optional: require ?token=... on the OpsBoard kiosk page.
OPSBOARD_TOKEN=

# ---------------------------------------------------------------------------
# RealtimeCorp (optional corporate snapshot sync)
#
# Leave CORP_SUPABASE_URL blank to keep this installation fully offline. When it is
# set, the suite pushes snapshots of its workforce data to the RealtimeCorp Supabase
# project. Use the service_role key here only: this file stays on the LAN server and
# the key is never sent to a browser.
# ---------------------------------------------------------------------------
#CORP_SUPABASE_URL=https://your-project.supabase.co
#CORP_SUPABASE_SERVICE_ROLE_KEY=
# Stable ids from RealtimeCorp (sites table / companies table).
#CORP_SITE_ID=
#CORP_COMPANY_ID=
#CORP_LOCATION_ID=
# Display name for this installation in the corporate console.
#CORP_SITE_NAME=
# Full reconciliation interval in minutes, plus a push shortly after local changes.
#CORP_SYNC_MINUTES=5
#CORP_CHANGE_SYNC=true
#CORP_SYNC_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# RTLink (optional employee companion app sync)
#
# Leave RTLINK_SUPABASE_URL blank to keep this installation offline. When it is set,
# the suite pushes each employee's schedule, tasks and requests to the RTLink
# Supabase project and applies the actions employees queue there. Use the
# service_role key here only: it never belongs in rtlink/.env or a browser.
# Run `python -m app.cli rtlink-site-id` to generate the site id once.
# ---------------------------------------------------------------------------
#RTLINK_SUPABASE_URL=https://your-project.supabase.co
#RTLINK_SUPABASE_SERVICE_ROLE_KEY=
#RTLINK_SITE_ID=
# Short code employees type into RTLink to pick this installation (2-32 chars).
#RTLINK_ORG_CODE=
#RTLINK_SITE_NAME=
# Full reconciliation interval in minutes, plus a push shortly after local changes.
#RTLINK_SYNC_MINUTES=5
#RTLINK_CHANGE_SYNC=true
# How often employee actions (requests, clock in/out) are applied, in seconds.
# Two seconds keeps RTLink feeling live; each poll is one small read.
#RTLINK_POLL_SECONDS=2
#RTLINK_SYNC_TIMEOUT_SECONDS=20

# Optional SMTP for onboarding emails. Leave blank to keep messages in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=realtimesuite@localhost
SMTP_USE_TLS=true
